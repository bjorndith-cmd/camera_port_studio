# SELinux rules for MIUI/HyperOS Camera
# Generated by Camera Port Studio

allow hal_camera_default system_data_file dir { search read write open getattr }
allow hal_camera_default system_data_file file { read write open getattr }
allow cameraserver system_data_file dir { search read write open getattr }
allow cameraserver system_data_file file { read write open getattr }
allow system_app cameraserver_service service_manager find
allow system_app hal_camera_default binder { call transfer }
allow priv_app cameraserver_service service_manager find
allow priv_app hal_camera_hwservice hwservice_manager find
allow hal_camera_default vendor_camera_data_file dir { search read write open getattr create add_name remove_name }
allow hal_camera_default vendor_camera_data_file file { read write open getattr create unlink }
